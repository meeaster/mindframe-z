{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "agents": {
      "default": [
        "opencode",
        "claude-code",
        "codex"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "opencode",
          "claude-code",
          "codex",
          "pi"
        ]
      }
    },
    "instructions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agents": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "opencode",
                "claude-code",
                "codex",
                "pi"
              ]
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "toggleable": {
            "default": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "const": "direct"
              },
              "agents": {
                "anyOf": [
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "opencode",
                        "claude-code",
                        "codex"
                      ]
                    },
                    "uniqueItems": true
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "enabled": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "opencode",
                                "claude-code",
                                "codex"
                              ]
                            },
                            "uniqueItems": true
                          },
                          "disabled": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "opencode",
                                "codex"
                              ]
                            },
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "enabled"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "enabled": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "opencode",
                                "claude-code",
                                "codex"
                              ]
                            },
                            "uniqueItems": true
                          },
                          "disabled": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "opencode",
                                "codex"
                              ]
                            },
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "disabled"
                        ],
                        "additionalProperties": false
                      }
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "enabled",
                            "disabled"
                          ],
                          "properties": {
                            "enabled": {
                              "contains": {
                                "const": "opencode"
                              }
                            },
                            "disabled": {
                              "contains": {
                                "const": "opencode"
                              }
                            }
                          }
                        },
                        {
                          "required": [
                            "enabled",
                            "disabled"
                          ],
                          "properties": {
                            "enabled": {
                              "contains": {
                                "const": "claude-code"
                              }
                            },
                            "disabled": {
                              "contains": {
                                "const": "claude-code"
                              }
                            }
                          }
                        },
                        {
                          "required": [
                            "enabled",
                            "disabled"
                          ],
                          "properties": {
                            "enabled": {
                              "contains": {
                                "const": "codex"
                              }
                            },
                            "disabled": {
                              "contains": {
                                "const": "codex"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "agents"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "const": "executor"
              },
              "connections": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "route"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "executor": {
      "type": "object",
      "properties": {
        "elicitation": {
          "type": "string",
          "const": "browser"
        },
        "timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "opencode": {
      "default": {
        "config": {},
        "dependencies": {},
        "plugins": [],
        "tui": {},
        "tui_plugins": [],
        "commands": [],
        "agents": []
      },
      "type": "object",
      "properties": {
        "config": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "dependencies": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        },
        "plugins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tui": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "tui_plugins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delegate_general": {
          "type": "object",
          "properties": {
            "models": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "variants": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "variants"
                ]
              }
            }
          }
        }
      }
    },
    "claude": {
      "default": {
        "settings": {}
      },
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "settings": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    },
    "codex": {
      "default": {
        "config": {},
        "plugins": {}
      },
      "type": "object",
      "properties": {
        "config": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "plugins": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "toggleable": {
                "type": "boolean"
              }
            },
            "required": [
              "enabled"
            ]
          }
        }
      }
    },
    "pi": {
      "default": {
        "settings": {},
        "subagent_config": {}
      },
      "type": "object",
      "properties": {
        "settings": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "subagent_config": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    },
    "mise": {
      "default": {
        "tools": {},
        "env": {},
        "tool_alias": {},
        "settings": {}
      },
      "type": "object",
      "properties": {
        "tools": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            ]
          }
        },
        "env": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "tool_alias": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "settings": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    },
    "thread": {
      "default": {
        "stores": [],
        "defaults": {},
        "credentials": "subscription"
      },
      "type": "object",
      "properties": {
        "stores": {
          "default": [],
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "publication": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "pull-request"
                      },
                      "base": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "pattern": "^(?!.*\\.\\.)(?!.*(?:^|\\/)\\.)(?!.*(?:^|\\/)[^/]*\\.lock(?:\\/|$))(?!.*\\/\\/)(?!.*[/.]$)[A-Za-z0-9][A-Za-z0-9._/-]*$"
                      },
                      "auto_merge": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "mode",
                      "base"
                    ],
                    "additionalProperties": false
                  },
                  "default": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "root",
                  "path",
                  "publication"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "publication": {
                    "default": "direct",
                    "type": "string",
                    "const": "direct"
                  },
                  "default": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "root",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "defaults": {
          "default": {},
          "type": "object",
          "properties": {
            "discover": {
              "type": "string"
            },
            "gather": {
              "type": "string"
            },
            "synthesize": {
              "type": "string"
            },
            "triage": {
              "type": "string"
            },
            "quiescence_minutes": {
              "type": "number",
              "minimum": 0
            },
            "digest": {
              "type": "string"
            },
            "session_sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "opencode"
                ]
              }
            }
          }
        },
        "update_strategy": {
          "type": "string",
          "enum": [
            "full",
            "delta"
          ]
        },
        "credentials": {
          "default": "subscription",
          "type": "string",
          "enum": [
            "bedrock",
            "subscription"
          ]
        }
      },
      "additionalProperties": false
    },
    "dotfiles": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "extra_folders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "read": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          },
          "edit": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}

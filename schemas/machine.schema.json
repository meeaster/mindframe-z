{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string"
    },
    "home_path": {
      "type": "string"
    },
    "references_dir": {
      "default": "~/.mindframe-z/references",
      "type": "string"
    },
    "extra_folders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "read": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          },
          "edit": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "git": {
      "default": {},
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "sandbox": {
      "default": {},
      "type": "object",
      "properties": {
        "credentials": {
          "type": "string",
          "enum": [
            "bedrock",
            "subscription"
          ]
        }
      }
    },
    "thread": {
      "default": {
        "stores": []
      },
      "type": "object",
      "properties": {
        "stores": {
          "default": [],
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "publication": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "pull-request"
                      },
                      "base": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "pattern": "^(?!.*\\.\\.)(?!.*(?:^|\\/)\\.)(?!.*(?:^|\\/)[^/]*\\.lock(?:\\/|$))(?!.*\\/\\/)(?!.*[/.]$)[A-Za-z0-9][A-Za-z0-9._/-]*$"
                      },
                      "auto_merge": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "mode",
                      "base"
                    ],
                    "additionalProperties": false
                  },
                  "default": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "root",
                  "path",
                  "publication"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "publication": {
                    "default": "direct",
                    "type": "string",
                    "const": "direct"
                  },
                  "default": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "root",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "work": {
      "default": {},
      "type": "object",
      "properties": {
        "units_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "archives": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string"
          },
          "prefix": {
            "default": "",
            "type": "string"
          },
          "default": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "bucket",
          "region"
        ]
      }
    },
    "opencode": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "claude": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  }
}

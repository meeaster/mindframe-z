{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "charter": {
      "type": "string",
      "minLength": 1
    },
    "store": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "read_subagents": {
      "type": "boolean"
    },
    "sessions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "claude-code",
              "opencode"
            ]
          },
          "title": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "time_range": {
            "type": "string"
          },
          "synthesizer": {
            "type": "string"
          },
          "message_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last_message_id": {
            "type": "string",
            "minLength": 1
          },
          "last_activity_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "message_count",
                  "last_message_id",
                  "last_activity_at"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "message_count"
                      ]
                    },
                    {
                      "required": [
                        "last_message_id"
                      ]
                    },
                    {
                      "required": [
                        "last_activity_at"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "excluded": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "claude-code",
              "opencode"
            ]
          },
          "title": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "synthesis": {
      "default": {},
      "type": "object",
      "properties": {
        "discover": {
          "type": "string"
        },
        "gather": {
          "type": "string"
        },
        "synthesize": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "charter",
    "store",
    "created_at"
  ],
  "additionalProperties": false
}
